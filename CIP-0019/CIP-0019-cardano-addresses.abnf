ADDRESS = %b0000 | PAYMENT-ADDRESS-TAG | KEY-HASH    | KEY-HASH       ; type 00, Base Shelley address
        \ %b0001 | PAYMENT-ADDRESS-TAG | SCRIPT-HASH | KEY-HASH       ; type 01, Base Shelley address
        \ %b0010 | PAYMENT-ADDRESS-TAG | KEY-HASH    | SCRIPT-HASH    ; type 02, Base Shelley address
        \ %b0011 | PAYMENT-ADDRESS-TAG | SCRIPT-HASH | SCRIPT-HASH    ; type 03, Base Shelley address
        \ %b0100 | NETWORK-TAG | KEY-HASH    | POINTER        ; type 04, Pointer Shelley address deprecated in Conway
        \ %b0101 | NETWORK-TAG | SCRIPT-HASH | POINTER        ; type 05, Pointer Shelley address deprecated in Conway
        \ %b0110 | PAYMENT-ADDRESS-TAG | KEY-HASH                     ; type 06, Payment Shelley address
        \ %b0111 | PAYMENT-ADDRESS-TAG | SCRIPT-HASH                  ; type 07, Payment Shelley address
        \ %b1000 | BYRON-PAYLOAD                              ; type 08, Byron / Bootstrap address
        \ %b1110 | NETWORK-TAG | KEY-HASH                     ; type 14, Stake Shelley address
        \ %b1111 | NETWORK-TAG | SCRIPT-HASH                  ; type 15, Stake Shelley address

NETWORK-TAG  = %b0000 ; Testnet
             \ %b0001 ; Mainnet

; Proposed CIP-160 extension: PROTECTED-NETWORK-TAG is valid only after
; the agreed activation. It applies to base/enterprise payment families above;
; pointer, reward/account and Byron addresses do not gain a protection flag.
PAYMENT-ADDRESS-TAG = NETWORK-TAG
                    \ PROTECTED-NETWORK-TAG

PROTECTED-NETWORK-TAG = %b1000 ; Protected testnet (network bit 0)
                      \ %b1001 ; Protected mainnet (network bit 1)

POINTER = VARIABLE-LENGTH-UINT ; slot number
        | VARIABLE-LENGTH-UINT ; transaction index
        | VARIABLE-LENGTH-UINT ; certificate index

VARIABLE-LENGTH-UINT = (%b1 | UINT7 | VARIABLE-LENGTH-UINT)
                     / (%b0 | UINT7)
UINT7 = 7BIT

KEY-HASH = 28OCTET

SCRIPT-HASH= 28OCTET

BYRON-PAYLOAD = *OCTET ; see 'Byron Addresses' section or cddl specification.
